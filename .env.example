# Copiar a .env y completar.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=serviciosrgl.com.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://serviciosrgl.com.ar
SITE_URL=https://serviciosrgl.com.ar

# 1 solo si no hay reverse proxy sirviendo ./data/media en /media/
SERVE_MEDIA=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Servicios RGL <no-responder@serviciosrgl.com.ar>
ADMIN_EMAIL=

NOTIFICADORES=email,semimanual
URGENCIA_MINUTOS_PARA_ACEPTAR=10
WORKER_INTERVALO_SEGUNDOS=30
FACEBOOK_GRUPO_URL=
PEDIDO_HORAS_AUTOCOMPLETAR=24
